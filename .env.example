# Never place a real encryption key in this file or commit it.
# Load production values via the host's secret manager/environment, not frontend VITE_* variables.
NODE_ENV=production
APPLICATION_PORT=3001
APPLICATIONS_ENABLED=false
ENQUIRIES_ENABLED=false
APP_ORIGIN=https://www.citizenhc.co.za
APPLICATION_DATA_DIR=/var/lib/citizen/applications
APPLICATION_ENCRYPTION_KEY=
APPLICATION_NOTICE_VERSION=
# ClamAV-compatible scanner; nonzero exit, timeout or unavailable scanner rejects uploads.
APPLICATION_SCANNER=/usr/bin/clamdscan
# Set only to the exact trusted reverse-proxy hop count; never expose API directly.
TRUST_PROXY_HOPS=1
# Set only after retention policy approval. Used by explicit host-side purge, not automatic.
APPLICATION_RETENTION_DAYS=

# Separate policy for employer enquiries. Unset means purge skips this record type.
ENQUIRY_RETENTION_DAYS=
